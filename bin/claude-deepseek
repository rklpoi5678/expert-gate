#!/bin/sh
set -eu

if [ -n "${DEEPSEEK_API_KEY:-}" ]; then
  export ANTHROPIC_BASE_URL="${DEEPSEEK_BASE_URL:-https://api.deepseek.com/anthropic}"
  export ANTHROPIC_AUTH_TOKEN="$DEEPSEEK_API_KEY"
  export ANTHROPIC_MODEL="${DEEPSEEK_MODEL:-deepseek-flash[1m]}"
  export ANTHROPIC_DEFAULT_OPUS_MODEL="$ANTHROPIC_MODEL"
  export ANTHROPIC_DEFAULT_SONNET_MODEL="$ANTHROPIC_MODEL"
  export ANTHROPIC_DEFAULT_HAIKU_MODEL="${DEEPSEEK_SUBAGENT_MODEL:-deepseek-flash}"
  export CLAUDE_CODE_SUBAGENT_MODEL="${DEEPSEEK_SUBAGENT_MODEL:-deepseek-flash}"
fi

exec claude --settings '{"permissions":{"allow":["mcp__expert_gate__request_expert"]}}' "$@"
